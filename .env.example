# ==============================================================================
# CCTV Local Recording & Event Publisher Worker Configuration
# ==============================================================================

# Unique identifier for this worker node
WORKER_ID=worker_recorder_01

# Central Backend REST API Endpoint to fetch camera configurations
API_BASE_URL=https://api-kamera.psti-ubl.id/devices
API_KEY_HEADER=x-api-key
API_KEY=
API_AUTH_TOKEN=

# RabbitMQ Broker Configuration (AMQP URI & Target Queue)
RABBITMQ_URL=amqp://guest:guest@195.35.23.135:5672/
RABBITMQ_QUEUE_NAME=cctv.recordings

# Local Storage Directory for Segmented MP4 Recordings
RECORD_STORAGE_PATH=/opt/recordings/queue

# Base URL for public / streaming playback (used in metadata event payload)
RECORDING_BASE_URL=http://195.35.23.135:9000/recordings

# Video Segmentation Duration in Seconds (Default: 300 = 5 minutes)
SEGMENT_DURATION_SECONDS=300

# Scanner / Watcher Check Interval in Seconds (Default: 5 seconds)
SCAN_INTERVAL_SECONDS=5

# Retry interval for stream auto-reconnection and API/RabbitMQ retries
RETRY_INTERVAL_SECONDS=5

# Future S3 / MinIO direct upload toggle
ENABLE_S3_UPLOAD=false

# Path to FFmpeg executable binary (Default: ffmpeg in system PATH)
FFMPEG_PATH=ffmpeg
